/TavernofSoul/TavernofSoul/*.save
/TavernofSoul/TavernofSoul/*.bak
/cron_*.sh

# local-only
.claude/
.env
.agent-keys.json

# Runtime output and downloaded game data (keep local copies).
/logs/
/TavernofSoul/TavernofSoul/*.pid
/Translation/
