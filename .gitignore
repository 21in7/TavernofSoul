ktos_unpack/
jtos_unpack/
ktest_unpack/
twtos_unpack/
itos_patch/
ktos_patch/
jtos_patch/
ktest_patch/
twtos_patch/
TavernofSoul/JSON_itos/
TavernofSoul/JSON_ktos/
TavernofSoul/JSON_ktest/
TavernofSoul/JSON_jtos/
TavernofSoul/JSON_twtos/
/TavernofSoul/itos/3.8/
/TavernofSoul/jtos/3.8/
/TavernofSoul/ktos/3.8/
/TavernofSoul/ktest/3.8/
/TavernofSoul/twtos/3.8/

# Regional deployment files (Passenger entrypoints and restart markers) stay local.
/TavernofSoul/itos/
/TavernofSoul/jtos/
/TavernofSoul/ktos/
/TavernofSoul/ktest/
/TavernofSoul/twtos/

# Local environments, backups, and operational configuration (keep on disk).
.venv/
venv/
/backups/
/*.ini
/TavernofSoul/*.ini
/TavernofSoul/TavernofSoul/*.ini
/TavernofSoul/TavernofSoul/settings.py
/TavernofSoul/TavernofSoul/shared_settings.py
/TavernofSoul/TavernofSoul/settings_itos.py
/TavernofSoul/TavernofSoul/settings_jtos.py
/TavernofSoul/TavernofSoul/settings_ktos.py
/TavernofSoul/TavernofSoul/settings_ktest.py
